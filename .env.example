# ============================================
# Template: copy to .env, then replace every "change-me"
#   cp .env.example .env
#   openssl rand -hex 16     (one value per password)
# .env is ignored by git: never commit it
# ============================================

# ============================================
# Project Configuration
# ============================================
PROJET_LABEL=suite
PROJET_PREFIX=suite
PROJET_NAME=docker-suite
PROJET_NET=172.146.0.0

# ============================================
# Base directory for docker volumes
# ============================================
LOCAL_VOLUMES_BASE=./volumes

# ============================================
# Dev user (shared by every dev container)
# DEV_UID / DEV_GID must match your local user (id -u / id -g):
# files in volumes/ then have the same owner on both sides
# ============================================
DEV_USER=dev_user
DEV_PASSWORD=change-me
DEV_UID=1000
DEV_GID=1000

# ============================================
# Service image (node + postgres)
# ============================================
NODE_VERSION=24.21.0
POSTGRES_VERSION=16
# Port sshd listens on inside every service container
SSH_EXPOSED_PORT=22
# PostgreSQL only listens on 127.0.0.1 inside its own container
DB_PORT=5432

# ============================================
# Core Container (nginx, the only public entry point)
# ============================================
CORE_NAME=suite-core
CORE_HOST=core-suite
CORE_IP=172.146.0.10
CORE_HTTP_PORT=80
CORE_HTTP_EXPOSED_PORT=80
CORE_SERVER_NAME=suite.local

# ============================================
# Web Container (UI, node only, reached through core at /)
# ============================================
WEB_NAME=suite-web
WEB_HOST=web-suite
WEB_IP=172.146.0.16
WEB_SSH_PORT=2201
WEB_HTTP_EXPOSED_PORT=4200

# ============================================
# Identity Service Container
# ============================================
IDENTITY_NAME=suite-identity
IDENTITY_HOST=identity-suite
IDENTITY_IP=172.146.0.21
IDENTITY_SSH_PORT=2202
IDENTITY_API_PORT=3000
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=change-me

# ============================================
# Notification Service Container
# ============================================
NOTIFICATION_NAME=suite-notification
NOTIFICATION_HOST=notification-suite
NOTIFICATION_IP=172.146.0.22
NOTIFICATION_SSH_PORT=2203
NOTIFICATION_SOCKET_PORT=3000
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=change-me

# ============================================
# Organization Service Container
# ============================================
ORGANIZATION_NAME=suite-organization
ORGANIZATION_HOST=organization-suite
ORGANIZATION_IP=172.146.0.23
ORGANIZATION_SSH_PORT=2204
ORGANIZATION_API_PORT=3000
ORGANIZATION_DB_NAME=organization_db
ORGANIZATION_DB_USER=organization_user
ORGANIZATION_DB_PASSWORD=change-me

# ============================================
# Employee Service Container
# ============================================
EMPLOYEE_NAME=suite-employee
EMPLOYEE_HOST=employee-suite
EMPLOYEE_IP=172.146.0.24
EMPLOYEE_SSH_PORT=2205
EMPLOYEE_API_PORT=3000
EMPLOYEE_DB_NAME=employee_db
EMPLOYEE_DB_USER=employee_user
EMPLOYEE_DB_PASSWORD=change-me

# ============================================
# Orchestration Service Container
# ============================================
ORCHESTRATION_NAME=suite-orchestration
ORCHESTRATION_HOST=orchestration-suite
ORCHESTRATION_IP=172.146.0.25
ORCHESTRATION_SSH_PORT=2206
ORCHESTRATION_API_PORT=3000
ORCHESTRATION_DB_NAME=orchestration_db
ORCHESTRATION_DB_USER=orchestration_user
ORCHESTRATION_DB_PASSWORD=change-me

# ============================================
# Suite Storage Container (memberships, payments, client organizations)
# ============================================
STORAGE_NAME=suite-storage
STORAGE_HOST=storage-suite
STORAGE_IP=172.146.0.31
STORAGE_SSH_PORT=2207
STORAGE_API_PORT=3000
STORAGE_DB_NAME=suite_db
STORAGE_DB_USER=suite_user
STORAGE_DB_PASSWORD=change-me

# ============================================
# Suite Event Bus Container (redis)
# ============================================
EVENT_BUS_NAME=suite-event-bus
EVENT_BUS_HOST=event-bus-suite
EVENT_BUS_IP=172.146.0.63
EVENT_BUS_PORT=6379
EVENT_BUS_PASSWORD=change-me
