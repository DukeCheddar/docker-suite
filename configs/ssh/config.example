# ===============================================
# SSH client configuration example
# For the machine you develop from, not for the containers.
#
# Append to ~/.ssh/config, then connect with:  ssh suite-identity
#
# Replace before use:
#   HostName           address of the machine running Docker
#   Port               the *_SSH_PORT of each container in your .env
#                      (the ports below are placeholders)
#   User               DEV_USER in your .env
#   IdentityFile       the private key whose public part is in authorized_keys
# ===============================================

Host suite-*
    HostName change-me
    User change-me
    IdentityFile change-me
    IdentitiesOnly yes

Host suite-web
    Port 2201

Host suite-identity
    Port 2202

Host suite-notification
    Port 2203

Host suite-organization
    Port 2204

Host suite-employee
    Port 2205

Host suite-orchestration
    Port 2206

Host suite-storage
    Port 2207
