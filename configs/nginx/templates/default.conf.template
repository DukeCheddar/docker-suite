# ===============================================
# Suite - Core dispatch
# Rendered at container start: ${...} comes from compose.yml,
# every other $variable belongs to nginx
# ===============================================

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${CORE_HTTP_EXPOSED_PORT};
    server_name ${CORE_SERVER_NAME};

    # Docker DNS, resolved per request: core starts and keeps running
    # even when a service container is down (502 for that service only)
    resolver 127.0.0.11 valid=10s ipv6=off;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # -------------------------------------------
    # API services: /api/<service>/... -> <service>:/...
    # -------------------------------------------
    location /api/identity/ {
        set $upstream ${IDENTITY_UPSTREAM};
        rewrite ^/api/identity/(.*)$ /$1 break;
        proxy_pass http://$upstream;
    }

    location /api/organization/ {
        set $upstream ${ORGANIZATION_UPSTREAM};
        rewrite ^/api/organization/(.*)$ /$1 break;
        proxy_pass http://$upstream;
    }

    location /api/employee/ {
        set $upstream ${EMPLOYEE_UPSTREAM};
        rewrite ^/api/employee/(.*)$ /$1 break;
        proxy_pass http://$upstream;
    }

    location /api/orchestration/ {
        set $upstream ${ORCHESTRATION_UPSTREAM};
        rewrite ^/api/orchestration/(.*)$ /$1 break;
        proxy_pass http://$upstream;
    }

    location /api/suite/ {
        set $upstream ${STORAGE_UPSTREAM};
        rewrite ^/api/suite/(.*)$ /$1 break;
        proxy_pass http://$upstream;
    }

    # -------------------------------------------
    # Socket service: notification (socket.io default path)
    # -------------------------------------------
    location /socket.io/ {
        set $upstream ${NOTIFICATION_UPSTREAM};
        proxy_pass http://$upstream;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # -------------------------------------------
    # UI: everything else -> web container
    # -------------------------------------------
    location / {
        set $upstream ${WEB_UPSTREAM};
        proxy_pass http://$upstream;
    }
}
